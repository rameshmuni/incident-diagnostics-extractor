# Copy this file to .env and fill in your real values.
# .env is gitignored on purpose - never commit real keys/passwords.
#
# Every setting below is read once, in config.py, into a plain constant -
# that's the only file that touches os.environ directly.

# ---------------------------------------------------------------------------
# LLM (Daisy) - OpenAI-compatible chat completions endpoint, Bearer auth.
# Example: if your gateway docs say "POST https://daisy.acme.com/v1/chat/completions",
# then DAISY_BASE_URL is "https://daisy.acme.com/v1" (no trailing /chat/completions -
# llm_daisy.py appends that itself).
# ---------------------------------------------------------------------------
DAISY_BASE_URL=https://daisy.yourcompany.internal/v1
DAISY_API_KEY=replace-with-your-bearer-key
DAISY_CHAT_MODEL=daisy-chat-default

# ---------------------------------------------------------------------------
# Embeddings (Daisy) - same gateway, usually the same base URL/key. Only set
# the two below if embeddings live behind a different host/key than chat.
# ---------------------------------------------------------------------------
DAISY_EMBEDDING_BASE_URL=https://daisy.yourcompany.internal/v1
DAISY_EMBEDDING_API_KEY=replace-with-your-bearer-key
DAISY_EMBEDDING_MODEL=daisy-embedding-default

# ---------------------------------------------------------------------------
# Vector store (ChromaDB) - local, on-disk, no server to run. Everything
# lives under CHROMA_PERSIST_DIR as a folder of files (including a sqlite
# db) right inside this project.
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=incident_knowledge

# ---------------------------------------------------------------------------
# ServiceNow
# SN_AUTH_MODE is "basic" (most instances) or "oauth_password" (only if your
# instance has Basic Auth disabled for the REST API - see servicenow_client.py).
# For oauth_password mode you also need SN_CLIENT_ID / SN_CLIENT_SECRET from
# an OAuth Application Registry; leave them blank for basic mode.
# ---------------------------------------------------------------------------
SN_INSTANCE=yourcompany
SN_AUTH_MODE=basic
SN_USER=svc-account-username
SN_PASS=replace-with-password
SN_CLIENT_ID=
SN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Confluence - ingest_confluence.py pulls pages from these spaces and loads
# them into the same Chroma collection as the ServiceNow incidents.
# CONFLUENCE_CLOUD=true for a *.atlassian.net site, false for Data Center/Server.
# CONFLUENCE_PAT is a Personal Access Token (Data Center/Server) or an API
# token (Cloud - pair it with CONFLUENCE_USERNAME below).
# ---------------------------------------------------------------------------
CONFLUENCE_URL=https://confluence.yourcompany.internal
CONFLUENCE_PAT=replace-with-your-personal-access-token
CONFLUENCE_USERNAME=
CONFLUENCE_CLOUD=false
# Comma-separated space keys to ingest, e.g. "OPS,RPA,ITSUPPORT"
CONFLUENCE_SPACE_KEYS=OPS,RPA

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
TOP_K=3
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200
